{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 0-5 * * 6"
  ],
  "packageRules": [
    {
      "description": "Enable minimum release age checks",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "7 days"
    }
  ],
  "lockFileMaintenance": {
    "schedule": [
      "* 0-5 * * 6"
    ],
    "enabled": true
  }
}
